{
  "schemaVersion": 1,
  "apiVersion": 6,
  "compatibility": {
    "minIdeVersion": "0.1.0",
    "capabilities": [
      "ui.webviews",
      "ui.settings",
      "editor.documents",
      "editor.save",
      "editor.history",
      "editor.notices",
      "editor.reveal",
      "media.playback",
      "ui.inline-launcher",
      "ui.native-browser-settings"
    ]
  },
  "entryPoint": "devline.tellfair.TellfairExtension",
  "extension": {
    "schemaVersion": 1,
    "id": "devline.tellfair",
    "version": "0.1.10",
    "name": {
      "en": "Tellfair",
      "ru": "Tellfair"
    },
    "description": {
      "en": "Text to speech with Tellfair and .tfspeech documents.",
      "ru": "Озвучка через Tellfair и документы .tfspeech."
    },
    "publisher": "DevLine",
    "icon": "data:image/png;base64,",
    "rpcNamespace": "tellfair",
    "enabledByDefault": true,
    "tools": [],
    "commands": []
  },
  "libraries": [
    "lib/devline-tellfair-0.1.0.jar",
    "lib/gson-2.13.2.jar"
  ],
  "webviews": [
    {
      "id": "settings",
      "title": {
        "en": "Tellfair",
        "ru": "Tellfair"
      },
      "html": "web/tellfair.html",
      "methods": [
        "settings",
        "cabinet"
      ],
      "location": "settings",
      "icon": "soundwave"
    },
    {
      "id": "speech",
      "title": {
        "en": "Tellfair",
        "ru": "Tellfair"
      },
      "html": "web/tellfair.html",
      "methods": [
        "settings",
        "presets",
        "generate",
        "job",
        "audio",
        "exportAudio",
        "cancel",
        "cabinet",
        "balance",
        "voices",
        "usage",
        "remoteJobs",
        "remoteJob"
      ],
      "inlineLauncher": true,
      "nativeBrowser": {
        "url": "https://tellfair.com/account",
        "urlMethod": "miniCabinet"
      }
    }
  ],
  "documentEditors": [
    {
      "id": "speech",
      "fileAssociation": true,
      "extensions": [
        "tfspeech"
      ],
      "icon": "data:image/png;base64,",

      "webview": "speech"
    }
  ]
}
